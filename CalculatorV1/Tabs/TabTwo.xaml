<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:local="clr-namespace:CalculatorV1"
             x:Class="CalculatorV1.Tabs.TabTwo"
             Title="UpdatedTabTwo">
    <Grid RowDefinitions="auto, auto" ColumnDefinitions="auto">
        <HorizontalStackLayout Grid.Row="0">
            <Entry  x:Name="Data1"
                        Placeholder="Measurement 1"
                        PlaceholderColor="Grey"
                        TextColor="black"
                        FontSize="Small"
                        Keyboard="Numeric"/>
            <Entry  x:Name="Data2"
                        Placeholder="Measurement 2"
                        PlaceholderColor="Grey"
                        TextColor="black"
                        FontSize="Small"
                        Keyboard="Numeric"/>
        </HorizontalStackLayout>
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center">
            <Label x:Name="message"
               Text=""/>
            <Button Text="Transfer data to next page!"
                FontSize="24"
                BackgroundColor="Green"
                Clicked="transferData"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>